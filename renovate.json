{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "kubernetes": {
        "fileMatch": [
            "\\.yaml$"
        ]
    },
    "packageRules": [
        {
            "description": "Manage generated Flux components as a coordinated release",
            "matchManagers": [
                "kubernetes"
            ],
            "matchFileNames": [
                "clusters/staging/flux-system/gotk-components.yaml"
            ],
            "enabled": false
        }
    ]
}